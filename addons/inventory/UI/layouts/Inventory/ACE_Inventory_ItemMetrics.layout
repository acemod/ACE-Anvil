HorizontalLayoutWidgetClass {
 Name "ACE_ItemMetrics"
 Slot LayoutSlot {
  HorizontalAlign 2
 }
 "Ignore Cursor" 1
 Color 0.242 0.242 0.242 1
 {
  HorizontalLayoutWidgetClass {
   Name "ACE_ExistingMetrics"
   Slot LayoutSlot {
    HorizontalAlign 2
   }
   "Inherit Color" 1
   {
    HorizontalLayoutWidgetClass {
     Name "ACE_StorageSummaryRow"
     Slot LayoutSlot {
      VerticalAlign 1
      Padding 0 0 18 0
     }
     "Is Visible" 0
     "Inherit Color" 1
     {
      HorizontalLayoutWidgetClass {
       Name "ACE_CompartmentCountRow"
       Slot LayoutSlot {
        VerticalAlign 1
        Padding 0 0 12 0
       }
       "Inherit Color" 1
       "Is Visible" 0
       {
        SizeLayoutWidgetClass {
         Name "ACE_CompartmentIconHolder"
         Slot LayoutSlot {
          VerticalAlign 1
         }
         "Inherit Color" 1
         AllowWidthOverride 1
         AllowHeightOverride 1
         WidthOverride 16
         HeightOverride 16
        }
        TextWidgetClass {
         Name "ACE_CompartmentCount"
         Slot LayoutSlot {
          VerticalAlign 1
          Padding 4 0 0 0
         }
         "Inherit Color" 1
         Text ""
         "Font Size" 14
         "Min Font Size" 14
         "Vertical Alignment" Center
        }
       }
      }
      HorizontalLayoutWidgetClass {
       Name "ACE_StorageVolumeRow"
       Slot LayoutSlot {
        VerticalAlign 1
       }
       "Inherit Color" 1
       {
        ImageWidgetClass {
         Name "ACE_StorageVolumeIcon"
         Slot LayoutSlot {
          VerticalAlign 1
         }
         "Inherit Color" 1
         Texture "{6A9B210991665254}UI/Textures/Inventory/ACE_Inventory_Capacity.edds"
         Size 16 16
        }
        TextWidgetClass {
         Name "ACE_StorageVolume"
         Slot LayoutSlot {
          VerticalAlign 1
          Padding 4 0 0 0
         }
         "Inherit Color" 1
         Text ""
         "Font Size" 14
         "Min Font Size" 14
         "Vertical Alignment" Center
        }
       }
      }
      HorizontalLayoutWidgetClass {
       Name "ACE_PocketSizeHolder"
       Slot LayoutSlot {
        VerticalAlign 1
        Padding 8 0 0 0
       }
       "Inherit Color" 1
      }
     }
    }
    HorizontalLayoutWidgetClass {
     Name "ACE_MetricsRow"
     Slot LayoutSlot {
      VerticalAlign 1
     }
     "Inherit Color" 1
     {
      HorizontalLayoutWidgetClass {
       Name "ACE_VolumeRow"
       Slot LayoutSlot {
        VerticalAlign 1
